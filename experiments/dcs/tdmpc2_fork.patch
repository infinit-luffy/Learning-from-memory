+"""Shim registering the Distracting Control Suite with TD-MPC2.
+
+The real code lives in the project tree (`experiments/dcs/dcs_env.py`) so that
+it is version-controlled; `third_party/tdmpc2` is an untracked pinned clone.
+This file plus one line in `envs/__init__.py` is the entire fork diff — see
+`experiments/dcs/tdmpc2_fork.patch`.
+"""
+import os
+import sys
+
+_PROJECT_ROOT = os.path.abspath(
+    os.path.join(os.path.dirname(__file__), os.pardir, os.pardir, os.pardir, os.pardir)
+)
+if _PROJECT_ROOT not in sys.path:
+    sys.path.insert(0, _PROJECT_ROOT)
+
+from experiments.dcs.dcs_env import make_env  # noqa: E402,F401
